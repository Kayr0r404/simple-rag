# Langfuse (self-hosted default: http://localhost:3000)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000

# LLM (Gemini, called over its OpenAI-compatible endpoint)
GEMINI_API_KEY=...
LLM_MODEL=gemini-3.5-flash-lite

# App
APP_ENV=dev
DEFAULT_CHUNK_SIZE=500
# Stage 6: fraction of traces to keep (1.0 = all)
LANGFUSE_SAMPLE_RATE=1.0
